{
  "name": "serina",
  "author": "ORN-Fox",
  "license": "MIT",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORN-Fox/serina-1.git"
  },
  "description": "GUI for create translation files for i18next",
  "keywords": [
    "translation",
    "i18next",
    "gui",
    "graphical",
    "electron",
    "angular",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/ORN-Fox/serina-1/issues"
  },
  "homepage": "https://github.com/ORN-Fox/serina-1#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:api": "npm run build:api && node api/dist/api.js",
    "build": "ng build",
    "build:api": "rimraf api/dist/ && babel ./api/ --out-dir api/dist/ --ignore ./node_modules,./.babelrc,./package.json,./npm-debug.log --copy-files",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:local": "ng test --browsers=Chrome",
    "test:api": "cd api && mocha -w  --full-trace",
    "electron:dev": "electron .",
    "build:electron": "rimraf dist release && npm run build && npm run build:api && electron-builder --projectDir . --publish=never",
    "package:win": "npm run build:electron -- --win",
    "package:linux": "npm run build:electron -- --linux",
    "package:mac": "npm run build:electron -- --mac"
  },
  "build": {
    "appId": "fr.ornfox.serina",
    "productName": "Serina",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/serina/**/*",
      "electron/**/*",
      "api/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.spec.*",
      "!src/**",
      "!app/**",
      "!samples/**",
      "!**/test/**"
    ],
    "extraResources": [
      {
        "from": "api/json",
        "to": "api/json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "body-parser": "^1.20.0",
    "express": "^4.22.1",
    "http-status-codes": "^2.3.0",
    "jsonfile": "^5.0.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.5",
    "@angular/cdk": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@babel/cli": "^7.28.6",
    "@iplab/ngx-file-upload": "^22.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~3.10.0",
    "@types/lodash": "^4.17.27",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^26.6.6",
    "babel-preset-es2015": "^6.24.1",
    "chai": "^6.2.2",
    "electron": "^41.5.0",
    "electron-builder": "^26.18.1",
    "file-saver": "^2.0.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.2.0",
    "json-formatter-js": "^2.5.18",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lodash": "^4.18.1",
    "material-design-icons": "^3.0.1",
    "mocha": "^11.7.5",
    "mousetrap": "^1.6.5",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "svg-country-flags": "^1.2.10",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "^6.0.0"
    },
    "karma-jasmine-html-reporter": {
      "jasmine-core": "^6.0.0"
    }
  }
}
