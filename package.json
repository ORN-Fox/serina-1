{
  "name": "serina",
  "author": "ORN-Fox",
  "license": "MIT",
  "version": "1.0.0",
  "main": "api/api.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORN-Fox/serina-1.git"
  },
  "description": "GUI for create translation files for i18next",
  "keywords": [
    "electron",
    "translation",
    "gui",
    "graphical",
    "i18next"
  ],
  "bugs": {
    "url": "https://github.com/ORN-Fox/serina-1/issues"
  },
  "homepage": "https://github.com/ORN-Fox/serina-1#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:api": "npm run build:api && node api/dist/api.js",
    "build": "ng build",
    "build:api": "rimraf api/dist/ && babel ./api/ --out-dir api/dist/ --ignore ./node_modules,./.babelrc,./package.json,./npm-debug.log --copy-files",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "cd api && mocha -w  --full-trace"
  },
  "dependencies": {
    "@angular/animations": "^16.1.7",
    "@angular/cdk": "16.1.6",
    "@angular/common": "^16.1.7",
    "@angular/compiler": "^16.1.7",
    "@angular/core": "^16.1.7",
    "@angular/forms": "^16.1.7",
    "@angular/material": "16.1.6",
    "@angular/platform-browser": "^16.1.7",
    "@angular/platform-browser-dynamic": "^16.1.7",
    "@angular/router": "^16.1.7",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "body-parser": "^1.20.0",
    "express": "^4.18.0",
    "jsonfile": "^5.0.0",
    "jsonformatter": "^0.7.0",
    "material-design-icons": "^3.0.1",
    "mousetrap": "^1.6.5",
    "rxjs": "~7.5.0",
    "svg-country-flags": "^1.2.10",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.6",
    "@angular/cli": "^16.1.6",
    "@angular/compiler-cli": "^16.1.7",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^12.11.1",
    "babel-cli": "^6.24.1",
    "babel-preset-es2015": "^6.24.1",
    "chai": "^4.2.0",
    "electron": "^24.2.0",
    "electron-packager": "^17.1.1",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "mocha": "^5.2.0",
    "multer": "^1.4.4",
    "rimraf": "^2.6.1",
    "typescript": "~4.9.5"
  }
}